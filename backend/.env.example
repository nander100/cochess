# Copy to backend/.env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
COACH_MODEL_SYNOPSIS=claude-sonnet-5-5
COACH_MODEL_CHAT=claude-haiku-5-5
DATABASE_URL=sqlite:///./cochess.db
# Postgres (v4, Amazon RDS in production): DATABASE_URL=postgresql+psycopg://user:password@host:5432/cochess?sslmode=require
# Where players open CoChess; `python -m app.cli invite` builds login links from it.
PUBLIC_BASE_URL=http://localhost:5173
# Optional: Claude tokens one player may use in a rolling 24 hours (off when unset).
# USER_DAILY_TOKEN_LIMIT=500000
# Game import (Lichess, Chess.com): how CoChess names itself to the platforms in the
# User-Agent. Chess.com asks API clients for a contact (an email or URL).
IMPORTS__APP_NAME=CoChess
# IMPORTS__CONTACT=you@example.com
# Sign in with Google (v4): an OAuth "Web application" client from Google Cloud. Off until both
# are set. Authorized redirect URI: PUBLIC_BASE_URL + /api/auth/google/callback.
# GOOGLE__CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE__CLIENT_SECRET=...
# The terms version players accept at sign-up; raise it when the terms change.
# LEGAL__TERMS_VERSION=2026-11-draft
# Account email through Amazon SES's SMTP interface (v4). Off unless enabled.
# EMAIL__ENABLED=true
# EMAIL__SMTP_HOST=email-smtp.us-east-2.amazonaws.com
# EMAIL__SMTP_USERNAME=...
# EMAIL__SMTP_PASSWORD=...
# EMAIL__FROM_ADDRESS=CoChess <account@mail.example.com>
# EMAIL__REPLY_TO=you@example.com
# Staging: only these addresses get mail (JSON list).
# EMAIL__ALLOW_LIST=["you@example.com"]
