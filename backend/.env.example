# Copy to backend/.env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
COACH_MODEL_SYNOPSIS=claude-sonnet-5-5
COACH_MODEL_CHAT=claude-haiku-5-5
DATABASE_URL=sqlite:///./cochess.db
# Where players open CoChess; `python -m app.cli invite` builds login links from it.
PUBLIC_BASE_URL=http://localhost:5173
# Optional: Claude tokens one player may use in a rolling 24 hours (off when unset).
# USER_DAILY_TOKEN_LIMIT=500000
# Game import (Lichess, Chess.com): how CoChess names itself to the platforms in the
# User-Agent. Chess.com asks API clients for a contact (an email or URL).
IMPORTS__APP_NAME=CoChess
# IMPORTS__CONTACT=you@example.com
